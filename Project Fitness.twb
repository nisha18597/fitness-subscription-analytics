      <column caption='Acquisition Channel' datatype='string' name='[Acquisition_Channel]' role='dimension' type='nominal' />
      <column caption='First Purchase Date' datatype='date' name='[Calculation_1017233774993408]' role='dimension' type='ordinal'>
